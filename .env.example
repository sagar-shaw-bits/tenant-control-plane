# Local-development values only. Replace with deployment-managed credentials outside local development.
HTTP_ADDR=:8080
DATABASE_URL=postgres://tenant:tenant@localhost:5432/tenant_control_plane?sslmode=disable
RABBITMQ_URL=amqp://tenant:tenant@localhost:5672/
RABBITMQ_USER=tenant
RABBITMQ_PASSWORD=tenant
OUTBOX_POLL_INTERVAL=200ms
OUTBOX_BATCH_SIZE=50
SHUTDOWN_TIMEOUT=10s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_BODY_LIMIT=1048576
CONSUMER_PREFETCH=10
CONSUMER_MAX_RETRIES=5
CONSUMER_RETRY_BASE_DELAY=100ms
CONSUMER_RETRY_MAX_DELAY=5s

# Worker simulator
FAIL_RATE=0
MIN_DELAY_MS=500
MAX_DELAY_MS=2000
DUPLICATE_RATE=0
OUT_OF_ORDER=false
PREFETCH=10